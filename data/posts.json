  "pages": {
    "index": {
      "t": {
        "k16": "분야별 전담 멘토가\n개인의 목표에 맞춰 이어가는 지도"
      },
      "l": {}
    },
    "programs": {
      "t": {
        "k61": "다양한 관찰과 탐구 활동을 바탕으로 자신만의 아이디어를 발전시키고,\n여러 표현 방식과 창작 방법을 경험하며 작품을 제작하는 미술 워크숍입니다.\n전문가의 강연과 실습, 교강사진의 피드백을 통해 창작의 가능성을 확장하고,\n작품 발표와 전시를 통해 창작 성과를 공유합니다.",
        "k74": "개별 작품 발표와 전시를 통해\n창작 결과물을 공유합니다."
      },
      "l": {
        "l3": [
          {
            "s": 0,
            "t": {
              "3": "전공별 특성을 반영한\n맞춤형 실기 지도"
            }
          },
          {
            "s": 1
          },
          {
            "s": 2,
            "t": {
              "3": "자신의 신체와\n음악적 표현 방식 탐색"
            }
          },
          {
            "s": 3,
            "t": {
              "3": "전통악기와 다양한 소리의\n탐색·구성·창작"
            }
          },
          {
            "s": 4,
            "t": {
              "3": "공연 관람 등 현장 경험을 통한\n전통예술 이해 확대"
            }
          }
        ]
      }
    },
    "camp": {
      "t": {
        "k5": "워크숍과 심화 멘토링을 거친 학생들이 함께 지내며\n분야별 집중 훈련과 분야 간 교류를 이어갑니다.\n\n마지막에는 한 해의 성과를 갈라공연으로 나눕니다.",
        "k8": "숙식을 함께하며 예술에만 집중합니다"
      },
      "l": {
        "l1": [
          {
            "s": 0,
            "t": {
              "2": "분야마다 전공 지도와\n개인 작업 시간을\n집중적으로 운영합니다."
            }
          },
          {
            "s": 1,
            "t": {
              "2": "다른 분야의 작업을 보고\n함께 만들어 보는\n융합 세션입니다."
            }
          },
          {
            "s": 2,
            "t": {
              "2": "네 분야가 한 무대에서\n한 해의 성과를 선보입니다."
            }
          },
          {
            "s": 3
          }
